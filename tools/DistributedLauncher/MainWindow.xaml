<Window x:Class="DistributedLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Distributed Physics Launcher" Height="760" Width="1100"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource Bg}" TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <!-- ============ palette ============ -->
        <SolidColorBrush x:Key="Bg"      Color="#14151A"/>
        <SolidColorBrush x:Key="Card"    Color="#1E2027"/>
        <SolidColorBrush x:Key="Card2"   Color="#23262E"/>
        <SolidColorBrush x:Key="Input"   Color="#0E0F13"/>
        <SolidColorBrush x:Key="Stroke"  Color="#2C2F38"/>
        <SolidColorBrush x:Key="Fg"      Color="#E6E8EE"/>
        <SolidColorBrush x:Key="Muted"   Color="#9AA0AD"/>
        <SolidColorBrush x:Key="Accent"  Color="#4C8DFF"/>
        <SolidColorBrush x:Key="Green"   Color="#3FB950"/>
        <SolidColorBrush x:Key="Red"     Color="#E5534B"/>
        <SolidColorBrush x:Key="Amber"   Color="#D29922"/>

        <!-- ============ text ============ -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,8,4"/>
        </Style>

        <!-- ============ inputs ============ -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Input}"/>
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ============ buttons ============ -->
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="Background" Value="{StaticResource Card2}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource BtnBase}"/>
        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{StaticResource Green}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{StaticResource Red}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- ============ card (GroupBox) ============ -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{StaticResource Card}" CornerRadius="9"
                                BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{TemplateBinding Header}" Margin="14,11,14,2"
                                           FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                                <ContentPresenter Margin="14,4,14,14"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ tabs ============ -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="b" Padding="13,7" Margin="0,0,2,0"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ dashboard row ============ -->
        <DataTemplate x:Key="EntityRow">
            <Border Background="{StaticResource Card2}" CornerRadius="6" Padding="12,8" Margin="0,3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="84"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" Margin="0"/>
                    <Border Grid.Column="1" CornerRadius="9" Padding="9,2" HorizontalAlignment="Left">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#3A3F4B"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="running">
                                        <Setter Property="Background" Value="#163021"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="stopped">
                                        <Setter Property="Background" Value="#33211F"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="exited">
                                        <Setter Property="Background" Value="#33211F"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding State}" FontSize="11" FontWeight="SemiBold" Margin="0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="running">
                                            <Setter Property="Foreground" Value="{StaticResource Green}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="stopped">
                                            <Setter Property="Foreground" Value="{StaticResource Red}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="exited">
                                            <Setter Property="Foreground" Value="{StaticResource Red}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding Metrics}" FontFamily="Consolas"
                               Foreground="#B9BEC9" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="0">
        <!-- ============ header bar ============ -->
        <Border DockPanel.Dock="Top" Background="#1A1B22" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1" Padding="18,12">
            <StackPanel Orientation="Horizontal">
                <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Distributed Physics Launcher" FontSize="16" FontWeight="Bold" Margin="0"/>
                <TextBlock Text="single pane — configure, launch and monitor the system" Foreground="{StaticResource Muted}" Margin="14,0,0,0"/>
            </StackPanel>
        </Border>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="376"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT: configuration ================= -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,14,0">
                <StackPanel>
                    <GroupBox Header="DEPLOY FOLDER">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DeployBox" Grid.Column="0"/>
                            <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse" Margin="8,3,0,3" Click="OnBrowse"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="RUN CONFIGURATION">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Physics servers"/>
                            <TextBox x:Name="ServersBox" Grid.Row="0" Grid.Column="1"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Clients"/>
                            <TextBox x:Name="ClientsBox" Grid.Row="1" Grid.Column="1"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Objects / player"/>
                            <TextBox x:Name="ObjectsBox" Grid.Row="2" Grid.Column="1"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Manager IP"/>
                            <TextBox x:Name="ManagerIpBox" Grid.Row="3" Grid.Column="1"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Manager port"/>
                            <TextBox x:Name="ManagerPortBox" Grid.Row="4" Grid.Column="1"/>

                            <CheckBox x:Name="HeadlessCheck" Grid.Row="5" Grid.Column="1"
                                      Content="Headless (no role windows)" IsChecked="True"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="WORLD BOUNDARIES (X / Z)">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="min X"/>
                            <TextBox x:Name="MinXBox" Grid.Row="0" Grid.Column="1" Margin="0,3,8,3"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="max X"/>
                            <TextBox x:Name="MaxXBox" Grid.Row="0" Grid.Column="3"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="min Z"/>
                            <TextBox x:Name="MinZBox" Grid.Row="1" Grid.Column="1" Margin="0,3,8,3"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="max Z"/>
                            <TextBox x:Name="MaxZBox" Grid.Row="1" Grid.Column="3"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="REMOTE MIDWARE AGENTS (host:port, one per line)">
                        <TextBox x:Name="RemoteAgentsBox" Height="54"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                    </GroupBox>

                    <WrapPanel>
                        <Button x:Name="SaveButton" Content="Save profile" Click="OnSaveProfile"/>
                        <Button x:Name="LoadButton" Content="Load profile" Click="OnLoadProfile"/>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= RIGHT: control + dashboard + logs ================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                    <Button x:Name="LaunchButton" Style="{StaticResource BtnPrimary}"
                            Content="&#9654;  Launch System" Click="OnLaunch"/>
                    <Button x:Name="StopButton" Style="{StaticResource BtnDanger}"
                            Content="&#9632;  Stop All" Click="OnStopAll"/>
                    <Button x:Name="ClearLogButton" Content="Clear logs" Click="OnClearLog"/>
                </StackPanel>

                <GroupBox Grid.Row="1" Header="LIVE STATUS" Margin="0,0,0,14">
                    <ItemsControl x:Name="Dashboard" ItemTemplate="{StaticResource EntityRow}"/>
                </GroupBox>

                <Border Grid.Row="2" Background="{StaticResource Card}" CornerRadius="9"
                        BorderBrush="{StaticResource Stroke}" BorderThickness="1" Padding="6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="LOGS" Margin="8,4,0,6"
                                   FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                        <TabControl x:Name="LogTabs" Background="Transparent"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
