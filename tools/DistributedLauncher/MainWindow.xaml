<Window x:Class="DistributedLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Distributed Physics Launcher" Height="680" Width="980"
        FontFamily="Segoe UI" FontSize="13" Background="#1E1E1E">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,8,4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Padding" Value="4,2,4,2"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5,10,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#9CDCFE"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="370"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT: configuration ================= -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
            <StackPanel>
                <GroupBox Header="Deploy folder">
                    <Grid Margin="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DeployBox" Grid.Column="0"/>
                        <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse..." Margin="8,3,0,3" Click="OnBrowse"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Run configuration">
                    <Grid Margin="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Physics servers"/>
                        <TextBox x:Name="ServersBox" Grid.Row="0" Grid.Column="1"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Clients"/>
                        <TextBox x:Name="ClientsBox" Grid.Row="1" Grid.Column="1"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Objects / player"/>
                        <TextBox x:Name="ObjectsBox" Grid.Row="2" Grid.Column="1"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Manager IP"/>
                        <TextBox x:Name="ManagerIpBox" Grid.Row="3" Grid.Column="1"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Manager port"/>
                        <TextBox x:Name="ManagerPortBox" Grid.Row="4" Grid.Column="1"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="World boundaries (X / Z)">
                    <Grid Margin="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="min X"/>
                        <TextBox x:Name="MinXBox" Grid.Row="0" Grid.Column="1" Margin="0,3,8,3"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="max X"/>
                        <TextBox x:Name="MaxXBox" Grid.Row="0" Grid.Column="3"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="min Z"/>
                        <TextBox x:Name="MinZBox" Grid.Row="1" Grid.Column="1" Margin="0,3,8,3"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="max Z"/>
                        <TextBox x:Name="MaxZBox" Grid.Row="1" Grid.Column="3"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Remote midware agents (host:port, one per line)">
                    <TextBox x:Name="RemoteAgentsBox" Margin="6" Height="64"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"/>
                </GroupBox>

                <WrapPanel Margin="0,4,0,0">
                    <Button x:Name="SaveButton" Content="Save profile" Click="OnSaveProfile"/>
                    <Button x:Name="LoadButton" Content="Load profile" Click="OnLoadProfile"/>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= RIGHT: control + status + logs ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="LaunchButton" Content="▶  Launch System" FontWeight="Bold"
                        Background="#2D7D2D" Foreground="White" Click="OnLaunch"/>
                <Button x:Name="StopButton" Content="■  Stop All"
                        Background="#7D2D2D" Foreground="White" Click="OnStopAll"/>
                <Button x:Name="ClearLogButton" Content="Clear log" Click="OnClearLog"/>
            </StackPanel>

            <Border Grid.Row="1" BorderBrush="#3C3C3C" BorderThickness="1" Margin="0,0,0,10">
                <ItemsControl x:Name="StatusList" Padding="6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{Binding Status}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Pid, StringFormat=pid {0}}" Foreground="#999999"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBox x:Name="LogBox" Grid.Row="2" IsReadOnly="True"
                     Background="#0C0C0C" Foreground="#CCCCCC" FontFamily="Consolas" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap" AcceptsReturn="True"/>
        </Grid>
    </Grid>
</Window>
